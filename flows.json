        "head": "",
        "format": "<template>\n    <span id=\"titulo\" class=\"titulo\">{{msg.payload.nome}}</span>\n    <div class=\"moldura\"></div>\n    <span id=\"classe\" class=\"classe\">\n            <span class=\"classe_yellow\">Classe: </span><span id=\"classe\" class=\"classe_white\">Nome da Classe</span>\n    </span>\n    <span id=\"nvl\" class=\"nvl\">Nvl. 1</span>\n    <span id=\"nvl\" class=\"exp_text\">Exp:</span>\n    <span id=\"exp\" class=\"exp\">\n            <span id=\"exp_white-1\" class=\"classe_white\">{{msg.payload.expAtual}}</span>\n    <span id=\"exp_yellow-1\" class=\"classe_yellow\"> / </span>\n    <span id=\"exp_white-2\" class=\"classe_white\">1800</span>\n    </span>\n</template>\n\n<script>\n    (function(scope) {\n        scope.$watch('msg', function(msg) {\n            if (!msg || !msg.payload) return;\n            const { nome, expAtual} = msg.payload;\n            document.getElementById('titulo').innerText = nome || 'Estudante';\n            document.getElementById('exp_white-1').innerText = expAtual || 0;\n        });\n})(scope);\n</script>\n\n<style>\n    body {\n        background-color: #383B53;\n    }\n\n    .titulo {\n        font-size: 30px;\n        color: rgba(242.985595703125, 200.6383514404297, 73.59659576416016, 1);\n        width: 140px;\n        left: 170px;\n        height: auto;\n        position: absolute;\n    }\n\n    .moldura {\n        position: absolute;\n        top: 30px;\n        height: 160px;\n        width: 160px;\n        background-size: cover;\n        background-position: center;\n        background-repeat: no-repeat;\n        background-image: url(/pixil-frame-0.png);\n        inset: 1px 1px 1px 1px;\n        border-radius: 0px 0px 0px 0px;\n        border-width: 6px 6px 6px 6px;\n        border-style: solid;\n        border-color: rgba(242.985595703125, 200.6383514404297, 73.59659576416016, 1);\n        pointer-events: none;\n        box-sizing: border-box;\n    }\n\n    .exp_text,\n    nvl {\n        line-height: 100%;\n        color: #F3C94A;\n    }\n\n    .exp_text {\n        position: absolute;\n        left: 170px;\n        top: 106px;\n    }\n\n    .exp {\n        text-align: right;\n        color: rgba(255, 255, 255, 1);\n        width: 150px;\n        position: absolute;\n        left: 178px;\n        top: 102px;\n    }\n\n    .nrdb-ui-progress-wrapper, .v-progress-linear v-progress-linear--active v-theme--nrdb v-locale--is-ltr {\n        top: -60px;\n        left: 170px;\n        width: 158px;\n        height: 20px;\n        position: relative\n    }\n\n    .nvl {\n        width: auto;\n        height: auto;\n        position: absolute;\n        left: 170px;\n        top: 36px;\n        white-space: pre;\n        flex-grow: 0;\n        color: #F3C94A;\n    }\n\n    .classe {\n        width: 150px;\n        height: 27px;\n        line-height: 20px;\n        position: absolute;\n        left: 170px;\n        top: 65px;\n    }\n\n    .classe_yellow {\n        color: rgba(242.985595703125, 200.6383514404297, 73.59659576416016, 1);\n        position: relative;\n    }\n\n    .classe_white {\n        color: rgba(255, 255, 255, 1);\n        position: relative;\n    }\n</style>",
