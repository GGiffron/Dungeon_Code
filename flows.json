        "func": "msg.topic = 'SELECT RANK() OVER(ORDER BY Nota DESC) AS Ranking, Aluno, Nota FROM( SELECT a.nome_aluno AS Aluno, SUM(n.nota) AS Nota FROM nota n JOIN aluno_turma atu ON n.id_aluno_turma = atu.id_aluno_turma JOIN aluno a ON atu.id_aluno = a.id_aluno JOIN materia_professor mp ON n.id_mat_prof = mp.id_mat_prof JOIN materia m ON mp.id_materia = m.id_materia WHERE m.id_materia = 1 GROUP BY a.nome_aluno) AS resultados ORDER BY Nota DESC;';\n\nreturn msg;",
